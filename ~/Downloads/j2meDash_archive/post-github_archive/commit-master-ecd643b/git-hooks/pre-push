#!/bin/bash

# Find the parent folder (j2meDash)
TARGET_DIR="~/Downloads/j2meDash_archive/post-github_archive/"

# Git passes: <local ref> <local sha1> <remote ref> <remote sha1> via stdin
while read -r local_ref local_sha remote_ref remote_sha; do
    
    # If remote_sha is all zeros, it's a brand new branch. 
    # We fetch the last 5 commits of this new branch just to be safe.
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        commit_range="-n 5 $local_sha"
    else
        # Only process commits between what's on the server and what you're pushing
        commit_range="$remote_sha..$local_sha"
    fi

    # Extract the clean branch name from the ref (refs/heads/feature -> feature)
    branch_clean=$(basename "$local_ref" | tr '/' '-')

    # Loop ONLY through the incoming commits (virtually instantaneous)
    for hash in $(git log --reverse --format="%H" "$commit_range" 2>/dev/null); do
        folder_name="commit-${branch_clean}-${hash:0:7}"
        
        if [ ! -d "$TARGET_DIR/$folder_name" ]; then
            echo "[Auto-Export] Extracting incoming commit: $folder_name"
            mkdir -p "$TARGET_DIR/$folder_name"
            git archive "$hash" | tar -x -C "$TARGET_DIR/$folder_name"
        fi
    done
done

